# Local development uses embedded PostgreSQL automatically.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
APP_ORIGIN=http://localhost:5173
# Production requires PostgreSQL and HTTPS APP_ORIGIN.
# DATABASE_URL=postgresql://transit:password@localhost:5432/transit
# DATABASE_SSL=true
# Optional PEM CA for managed PostgreSQL:
# DATABASE_CA=
# Set true only when an explicitly trusted reverse proxy sanitizes forwarded headers.
TRUST_PROXY=false
DEMO_DATA=true
PGLITE_PATH=.data/transit
